# Secretarybird: let the person signed in to this computer talk to Razer devices
# (USB vendor 1532) without root. Install to /etc/udev/rules.d/, then unplug and
# replug the device, or run: sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", TAG+="uaccess"
